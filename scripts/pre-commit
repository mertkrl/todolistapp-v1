#!/usr/bin/env bash
# Git pre-commit hook: staged .js dosyalarında YENİ escape edilmemiş
# innerHTML enjeksiyonu var mı diye bakar (bkz. scripts/check-innerhtml-gate.py).
# Mevcut bilinen bulgular (scripts/innerhtml-baseline.txt) commit'i engellemez,
# sadece o listede olmayan yeni bulgular engeller.
#
# Repo kökü artık bu projenin kendisi (todolistapp v1) — ayrı bir alt yol
# hesaplamaya gerek yok.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

staged_js=()
while IFS= read -r line; do
  [ -n "$line" ] && staged_js+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.js' || true)

if [ "${#staged_js[@]}" -eq 0 ]; then
  exit 0
fi

python3 scripts/check-innerhtml-gate.py "${staged_js[@]}"
python3 scripts/check-window-bridge-baseline.py "${staged_js[@]}"
python3 scripts/check-duplicate-window-bridges.py
